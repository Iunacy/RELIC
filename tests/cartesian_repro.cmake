if(DOF EQUAL 3)
  set(start "0,0,0")
  set(target "0.5076515983,0.3182719335,0.2342000037")
else()
  set(start "0,0,0,0")
  set(target "0.4774930318,0.3102351519,0.2467768943")
endif()
foreach(run IN ITEMS a b)
  execute_process(COMMAND "${DEMO}" --config "${CONFIG}" --start "${start}" --target "${target}" --csv "${OUT}_${run}.csv"
    RESULT_VARIABLE code OUTPUT_VARIABLE report ERROR_VARIABLE error)
  if(NOT code EQUAL 0 OR NOT report MATCHES "status=Success" OR NOT report MATCHES "settled=1")
    message(FATAL_ERROR "Cartesian execution failed: ${code} ${report} ${error}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}_a.csv" "${OUT}_b.csv" RESULT_VARIABLE differs)
if(NOT differs EQUAL 0)
  message(FATAL_ERROR "Cartesian traces differ on deterministic replay")
endif()
execute_process(COMMAND "${DEMO}" --config "${CONFIG}" --start "${start}" --target "5,5,5" --csv "${OUT}_denied.csv"
  RESULT_VARIABLE code OUTPUT_VARIABLE report)
if(NOT code EQUAL 2 OR NOT report MATCHES "execution_started=0")
  message(FATAL_ERROR "Unreachable execution must return failure without moving")
endif()
execute_process(COMMAND "${DEMO}" --config "${CONFIG}" --start "${start}" --target "${target}" --csv "${CONFIG}"
  RESULT_VARIABLE code OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT code EQUAL 1 OR NOT error MATCHES "paths must be distinct")
  message(FATAL_ERROR "Output alias protection failed")
endif()
message(STATUS "Actuator-driven Cartesian replay byte-identical; explicit failure and alias protection passed")
